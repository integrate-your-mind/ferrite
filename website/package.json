{
  "name": "ferrite-project-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "prepare:runtime": "pnpm -C .. --filter @ferrite/protocol build && pnpm -C .. --filter @ferrite/runtime build",
    "check": "pnpm run prepare:runtime && cargo run --manifest-path ../Cargo.toml -p ferrite-cli -- check --project .",
    "build": "pnpm run prepare:runtime && cargo run --manifest-path ../Cargo.toml -p ferrite-cli -- build --project . --page-renderer ../packages/runtime/bin/render-page.mjs --client-bundler ../packages/runtime/bin/build-client.mjs",
    "start": "cargo run --manifest-path ../Cargo.toml -p ferrite-cli -- serve --project . --artifact .ferrite/build --page-renderer ../packages/runtime/bin/render-artifact.mjs",
    "package:sites": "node deploy-adapter.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint deploy-adapter.mjs tests/*.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ferrite/runtime": "link:../packages/runtime"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "eslint": "9.39.4",
    "typescript": "6.0.3"
  }
}
