{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@ferrite/runtime",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "@ferrite/runtime": ["../../packages/runtime/src/index.ts"],
      "@ferrite/runtime/jsx-runtime": ["../../packages/runtime/src/jsx-runtime.ts"],
      "@ferrite/runtime/server": ["../../packages/runtime/src/server.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["app/**/*.d.ts", "app/**/*.tsx", ".ferrite/types/**/*.d.ts"]
}
