{
  "name": "@ferrite/node",
  "version": "0.1.0",
  "private": true,
  "description": "Native Node.js bindings for Ferrite Rust server-side rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integrate-your-mind/ferrite.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/integrate-your-mind/ferrite#readme",
  "bugs": {
    "url": "https://github.com/integrate-your-mind/ferrite/issues"
  },
  "keywords": [
    "ferrite",
    "node-api",
    "native",
    "ssr",
    "rust"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "binding.js",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "cargo build -p ferrite-node && node scripts/copy-native.mjs",
    "prebuild:package": "pnpm build && node scripts/create-prebuild-package.mjs",
    "prebuild:verify": "node scripts/verify-prebuild-package.mjs dist/prebuild",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "node --check binding.js && node --check index.js && node --check scripts/copy-native.mjs && node --check scripts/create-prebuild-package.mjs && node --check scripts/verify-prebuild-package.mjs"
  }
}
