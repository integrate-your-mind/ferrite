{
  "name": "@ferrite/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
