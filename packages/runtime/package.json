{
  "name": "@ferrite/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript JSX runtime, DOM helpers, and server facade for the Rust-first Ferrite framework.",
  "license": "UNLICENSED",
  "keywords": [
    "ferrite",
    "jsx",
    "runtime",
    "typescript",
    "ssr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "@ferrite/protocol": "workspace:*"
  },
  "scripts": {
    "build": "pnpm --filter @ferrite/protocol build && tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "pnpm --filter @ferrite/protocol build && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "esbuild": "0.28.1",
    "happy-dom": "20.10.6",
    "typescript": "6.0.3"
  }
}
