{
  "name": "@ferrite/runtime",
  "version": "0.1.0-alpha.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "TypeScript JSX runtime, DOM helpers, and server facade for the Rust-first Ferrite framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integrate-your-mind/ferrite.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/integrate-your-mind/ferrite#readme",
  "bugs": {
    "url": "https://github.com/integrate-your-mind/ferrite/issues"
  },
  "keywords": [
    "ferrite",
    "jsx",
    "runtime",
    "typescript",
    "ssr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "@ferrite/protocol": "workspace:*",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "pnpm --filter @ferrite/protocol build && tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "pnpm --filter @ferrite/protocol build && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "happy-dom": "20.10.6"
  }
}
