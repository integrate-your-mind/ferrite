#!/usr/bin/env bash
set -euo pipefail

if [[ -n "$(builtin declare -Fx)" ]]; then
  printf 'Ferrite Buildkite trust check: imported shell functions are not allowed\n' >&2
  exit 1
fi

case "${BUILDKITE_COMMAND:-}" in
  "./.buildkite/scripts/upload-pipeline.sh" | \
  "./.buildkite/scripts/ci.sh verify" | \
  "./.buildkite/scripts/ci.sh packages" | \
  "./.buildkite/scripts/ci.sh coverage-rust" | \
  "./.buildkite/scripts/ci.sh coverage-js" | \
  "./.buildkite/scripts/ci.sh native" | \
  "./.buildkite/scripts/ci.sh nginx")
    ;;
  *)
    printf 'Ferrite Buildkite trust check: command is not allowlisted\n' >&2
    exit 1
    ;;
esac

# Checkout may need the agent account's read-only Git credential. The project
# command does not; remove common interactive credential helpers before it runs.
unset \
  BASH_ENV \
  CDPATH \
  ENV \
  GIT_ASKPASS \
  GIT_SSH_COMMAND \
  SSH_ASKPASS \
  SSH_AUTH_SOCK
